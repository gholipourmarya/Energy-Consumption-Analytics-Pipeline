{
  "title": "Energy Consumption",
  "uid": "energy-consumption",
  "schemaVersion": 41,
  "timezone": "utc",
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Daily energy consumption",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "energy-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "energy-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select reading_date::timestamp at time zone 'UTC' as time,\n       total_kwh::double precision as kwh\nfrom analytics.daily_consumption\nwhere $__timeFilter(reading_date::timestamp at time zone 'UTC')\norder by time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Daily consumption by meter",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "energy-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "energy-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select reading_date as \"Date\", meter_id as \"Meter\",\n       round(total_kwh, 2) as \"kWh\", readings as \"Readings\",\n       flagged_readings as \"Flagged\"\nfrom analytics.daily_meter_consumption\nwhere $__timeFilter(reading_date::timestamp at time zone 'UTC')\norder by reading_date desc, meter_id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Streaming data quality",
      "type": "timeseries",
      "timeFrom": "24h",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "energy-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "energy-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(recorded_at, '5m'),\n       sum(accepted) as \"Accepted\",\n       sum(rejected) as \"Rejected\",\n       sum(duplicates) as \"Duplicates\"\nfrom analytics.stream_quality\nwhere $__timeFilter(recorded_at)\ngroup by 1\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {"mode": "normal", "group": "quality"}
          }
        },
        "overrides": []
      }
    }
  ]
}
